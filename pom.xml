<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.ibcalpha</groupId>
  <artifactId>ibc</artifactId>
  <version>3.24.1</version>
  <packaging>jar</packaging>
  <name>IBC - Interactive Brokers Controller</name>
  <description>Automates IB TWS and IB Gateway login, dialog handling, and session management</description>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <build>
    <!-- Keep existing src/ layout instead of src/main/java -->
    <sourceDirectory>src</sourceDirectory>
    <testSourceDirectory>test</testSourceDirectory>
    <finalName>IBC</finalName>

    <plugins>

      <!-- (0) Clean dist/ and resources/IBC.jar in addition to target/ -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <filesets>
            <fileset>
              <directory>${project.basedir}/dist</directory>
            </fileset>
            <fileset>
              <directory>${project.basedir}/resources</directory>
              <includes>
                <include>IBC.jar</include>
                <include>version</include>
              </includes>
            </fileset>
          </filesets>
        </configuration>
      </plugin>

      <!-- (1) Require IBC_BIN environment variable -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>require-maven-version</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.8,)</version>
                  <message>Maven 3.8+ is required to build IBC.</message>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>require-ibc-bin</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireEnvironmentVariable>
                  <variableName>IBC_BIN</variableName>
                  <message>Environment variable 'IBC_BIN' not set (set it to the fully-qualified directory containing the TWS/Gateway jar files).</message>
                </requireEnvironmentVariable>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- (2) antrun: generate IbcVersionInfo.java, compile sources, write resources/version.
           Uses maven.compile.classpath (Maven-managed deps) + IBC_BIN fileset (TWS/Gateway jars),
           mirroring the original Ant build.xml. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>generate-version-info</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <mkdir dir="${project.build.directory}/generated-sources/java/ibcalpha/ibc"/>
                <echo file="${project.build.directory}/generated-sources/java/ibcalpha/ibc/IbcVersionInfo.java">// NB: this file is generated by the Maven build
package ibcalpha.ibc;

public class IbcVersionInfo {
    public final static String IBC_VERSION = "${project.version}";
}
</echo>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>compile-sources</id>
            <phase>compile</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <mkdir dir="${project.build.outputDirectory}"/>
                <javac destdir="${project.build.outputDirectory}"
                       release="17"
                       debug="true"
                       includeantruntime="false">
                  <!--
                    debug="true" keeps line-number/local-variable/source debug info in
                    the compiled classes. Ant's <javac> defaults debug to false (unlike
                    the javac CLI), which silently strips this metadata. Without it,
                    JaCoCo can still count instructions/branches from raw bytecode but
                    cannot map any of them back to source lines, so the coverage report
                    has zero <sourcefile>/<line> data and line-coverage tools (octocov)
                    read that as 0% regardless of actual test coverage.
                  -->
                  <src path="${project.build.sourceDirectory}"/>
                  <src path="${project.build.directory}/generated-sources/java"/>
                  <classpath>
                    <path refid="maven.compile.classpath"/>
                    <fileset dir="${env.IBC_BIN}" includes="**/*.jar"/>
                  </classpath>
                  <compilerarg value="-Xlint:all"/>
                </javac>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>write-version-file</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <echo file="${project.basedir}/resources/version" message="${project.version}"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- (3) Register generated-sources directory as additional source root for IDEs -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>add-generated-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.build.directory}/generated-sources/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- (4) Disable default maven-compiler-plugin — compilation handled by antrun above -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <executions>
          <execution>
            <id>default-compile</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <outputDirectory>${project.basedir}/resources</outputDirectory>
        </configuration>
      </plugin>

      <!-- (6) Linux distribution ZIP → dist/IBCLinux-{version}.zip -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.8.0</version>
        <executions>
          <execution>
            <id>ibc-linux</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
            <configuration>
              <skipAssembly>${skipAssembly}</skipAssembly>
              <descriptors>
                <descriptor>src/assembly/linux.xml</descriptor>
              </descriptors>
              <finalName>IBCLinux-${project.version}</finalName>
              <appendAssemblyId>false</appendAssemblyId>
              <outputDirectory>${project.basedir}/dist</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- (7) Run JUnit 5 tests with headless AWT/Swing -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.6</version>
        <configuration>
          <systemPropertyVariables>
            <java.awt.headless>true</java.awt.headless>
          </systemPropertyVariables>
          <!--
            @{argLine} is set by jacoco:prepare-agent (the -javaagent flag that
            attaches JaCoCo's coverage instrumentation to the test JVM). It MUST
            be interpolated here, or Surefire silently drops it and no coverage
            data is ever recorded (jacoco:report then finds no jacoco.exec and
            produces nothing, which is what was happening before this fix).
          -->
          <argLine>@{argLine} --add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.lang.reflect=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.desktop/java.awt=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>

      <!-- (8) JaCoCo coverage report for octocov -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.15</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.reporting.outputDirectory}/jacoco</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- (9) Checkstyle with test-file suppressions for reviewdog -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <suppressionsLocation>checkstyle-suppressions.xml</suppressionsLocation>
        </configuration>
      </plugin>

      <!-- (10) SpotBugs static analysis — advisory only during baseline phase.
           Runs on `mvn spotbugs:check` or during the verify phase. -->
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>4.10.3.0</version>
        <configuration>
          <effort>Max</effort>
          <threshold>Medium</threshold>
          <failOnError>false</failOnError>
          <includeTests>true</includeTests>
        </configuration>
        <executions>
          <execution>
            <id>spotbugs-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

  <!--
    junit-bom keeps org.junit.jupiter:* and org.junit.platform:* on matching
    versions. Required since JUnit 6: junit-jupiter does not pull in
    junit-platform-launcher transitively, and Surefire bundles its own launcher.
    A launcher out of sync with Jupiter makes Surefire discover zero tests and
    still report BUILD SUCCESS, so the launcher is declared explicitly below.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>6.1.2</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>5.23.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
