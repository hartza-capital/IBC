{
  "mcpServers": {
    "codebase-memory-mcp": {
      "command": "codebase-memory-mcp"
    },
    "github": {
      "command": "github-mcp-server",
      "args": ["stdio"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "gomuta": {
      "command": "gomuta",
      "env": {
        "GOMUTA_ROOT": "${HOME}/go/src/github.com/hartza-capital"
      }
    }
  }
}
