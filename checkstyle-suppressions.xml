<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
    <!-- Tests are not subject to the production source style rules. -->
    <suppress files="^test[/\\].*\.java$" checks=".*"/>

    <!-- VisibilityModifier: this legacy fork exposes package-private fields
         that other classes in the same ibcalpha.ibc package read directly.
         Fixing this file-by-file risks silently breaking cross-file field
         access, since a single-file pass can't see every call site. Treated
         as legacy noise rather than a real defect. -->
    <suppress files=".*\.java$" checks="VisibilityModifier"/>

    <!-- JavadocVariable: mandates a Javadoc block on every field, including
         private implementation fields. This is disproportionate noise for a
         codebase where only methods are expected to carry Javadoc (see
         function-documenter standard); not treated as a real defect. -->
    <suppress files=".*\.java$" checks="JavadocVariable"/>
</suppressions>
