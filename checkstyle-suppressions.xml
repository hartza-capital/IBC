<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
    <!-- Tests are not subject to the production source style rules. -->
    <suppress files="^test[/\\].*\.java$" checks=".*"/>

    <!-- LoginManager exposes the historical uppercase FIX/IBAPI credential
         accessor names (FIXPassword, FIXUserName, IBAPIPassword, IBAPIUserName)
         as part of the public API. Renaming them would require touching many
         callers outside the PR scope, so their method-name style is suppressed
         here rather than changed. -->
    <suppress files="LoginManager\.java" checks="MethodName"/>

    <!-- ConfigureApiPrecautionsTask receives nine positional configuration
         settings that map one-to-one to the TWS API > Precautions checkboxes.
         Collapsing them would require an invasive caller-side refactor, so the
         constructor's parameter count is suppressed as a structural constraint
         rather than a style issue. -->
    <suppress files="ConfigureApiPrecautionsTask\.java" checks="ParameterNumber"/>

</suppressions>
